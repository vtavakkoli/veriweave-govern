# Replace this value in every non-development environment.
GOVERN_AUDIT_SIGNING_KEY=replace-with-a-long-random-secret

# Publication-validation LLM baseline. Docker Desktop reaches the host Ollama
# API through host.docker.internal. The pipeline invokes this model through
# /api/chat; it does not use the old deterministic LLM proxy.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Optional timeout for the real Ollama preflight invocation.
OLLAMA_PROBE_TIMEOUT=120

# Publication statistical analysis: fixed resampling settings for reproducibility.
PUBLICATION_BOOTSTRAP_SAMPLES=10000
PUBLICATION_BOOTSTRAP_SEED=20260817

# Optional publication load-matrix overrides.
LOAD_MATRIX_REQUESTS_PER_LEVEL=10000
LOAD_MATRIX_CONCURRENCIES=1,4,16,32
