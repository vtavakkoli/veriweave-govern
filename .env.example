# Replace this value in every non-development environment.
GOVERN_AUDIT_SIGNING_KEY=replace-with-a-long-random-secret

# Publication-validation baseline. Docker Desktop can reach host Ollama using
# host.docker.internal; override this for another Docker/network environment.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Optional publication load-matrix overrides.
LOAD_MATRIX_REQUESTS_PER_LEVEL=10000
LOAD_MATRIX_CONCURRENCIES=1,4,16,32
